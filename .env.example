# ==============================================================================
# AI Attendance System - Environment Configuration Template
# ==============================================================================
# Duplicate this file as '.env' and fill in your actual credentials.
# Never commit your active '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database Configuration
# ------------------------------------------------------------------------------
# Your Supabase Project URL (found in Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon Key or Service Role Key
# (SUPABASE_KEY and SUPABASE_SECRET_KEY are both supported)
SUPABASE_KEY=your-supabase-api-key-here
SUPABASE_SECRET_KEY=your-supabase-api-key-here

# ------------------------------------------------------------------------------
# 2. Authentication & JWT Security Settings
# ------------------------------------------------------------------------------
# Secret key used for signing JWT tokens.
# Generate a strong 64-character secret using:
#   Linux/macOS : openssl rand -hex 32
#   PowerShell  : -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 64 | ForEach-Object {[char]$_})
#   Python      : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-secure-random-64-character-secret-key-here

# JWT token expiration time in minutes (default is 60)
ACCESS_TOKEN_MINUTES=60
